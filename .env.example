# Zuntra Lead Intelligence - Production Environment Configuration Template

# Financial & Market Data APIs
FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
SEC_USER_AGENT=YourCompanyName contact@example.com

# News & Media Discovery APIs
NEWSAPI_API_KEY=your_newsapi_api_key
GNEWS_API_KEY=your_gnews_api_key

# Groq LLM Intelligence Models
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
NEWS_GROQ_MODEL=llama-3.1-8b-instant

# Code & Integration APIs
GITHUB_TOKEN=your_github_personal_access_token
TRACXN_ACCESS_TOKEN=your_tracxn_access_token

# LinkedIn Automation & Lead Scraper (Playwright)
LINKEDIN_EMAIL=your_linkedin_email@domain.com
LINKEDIN_PASSWORD=your_linkedin_password
DELAY_MIN_SECONDS=3
DELAY_MAX_SECONDS=8
HEADLESS=true
CHECKPOINT_TIMEOUT_SECONDS=600

# Database Persistence (Supabase PostgreSQL)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Web Server Tuning
HOST=0.0.0.0
PORT=5000
WAITRESS_THREADS=8
FLASK_DEBUG=false
