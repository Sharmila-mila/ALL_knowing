# API Keys & Configuration for ALL_knowing

# Groq API Key (for LLM company synthesis and news relevance filtering)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Finnhub API Key (for company profiles, metrics & financial data)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API Key (for financial overview & market metrics)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# News API Keys (for company news intelligence)
NEWSAPI_API_KEY=your_newsapi_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# GitHub Token (for developer profile & repository scraping)
GITHUB_TOKEN=your_github_token_here

# SEC Edgar User Agent
SEC_USER_AGENT=ALL_knowing_Scraper admin@example.com

# Supabase (Optional: for persistent cloud storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
